# Supabase 접속 정보 (.env 파일로 복사해서 값을 채우세요)
# 대시보드 → Project Settings → API Keys 에서 확인
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase 대시보드에서 실제 활성화한 제공자만 쉼표로 구분
# 카카오와 네이버는 내부적으로 custom:kakao, custom:naver에 연결된다.
VITE_AUTH_PROVIDERS=google,kakao,naver
